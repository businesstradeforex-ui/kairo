# Copy to .env and fill in only what you use. Never commit .env.
# Paper trading is the default. Leave KAIRO_LIVE_ENABLED=0 until you really want real orders.

KAIRO_ENV=production
KAIRO_PUBLIC_URL=http://127.0.0.1:8787
DESK_HOST=127.0.0.1
DESK_PORT=8787
# 1 only behind Cloudflare Tunnel or another reverse proxy on loopback
TRUST_PROXY=0
COOKIE_SECURE=auto
MEMEDESK_DATA=
# 0 = one folder, original single-portfolio desk. 1 = one portfolio per account.
KAIRO_MULTIUSER=1
DESK_PROFILE=
DESK_BANKROLL_EUR=1000
# Optional fixed FX for tests. Leave empty in production (live ECB rate).
KAIRO_FX=
# Fernet key (or any long passphrase). If empty, a chmod 600 secret.key is created in the data dir.
KAIRO_SECRET_KEY=
# First account with this email becomes owner. If empty, the first signup is the owner.
KAIRO_OWNER_EMAIL=

# Remote assistant: comma-separated IPs. Empty = allowlist off.
KAIRO_ADMIN_ALLOWLIST=

# Live trading master switch. Stays off. Per-account opt-in is also required.
KAIRO_LIVE_ENABLED=0
KAIRO_LIVE_MAX_ORDER_USD=50
KAIRO_LIVE_MAX_DAILY_USD=200

# Local model. auto = OpenAI-compatible if OPENAI_BASE_URL is set, otherwise Ollama.
KAIRO_LLM_BACKEND=auto
KAIRO_LLM_MODEL=qwen3:4b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# LM Studio, llama.cpp server, vLLM, LocalAI… example: http://127.0.0.1:1234/v1
OPENAI_BASE_URL=
OPENAI_API_KEY=
KAIRO_LLM_TIMEOUT_S=180

# Magic links. Disabled until SMTP_HOST is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1

# Google sign-in. Disabled until both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple. Disabled until all four are set.
# APPLE_PRIVATE_KEY is a PEM string or a path to a .p8 file (do not commit it).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Optional git checkout whose static/ replaces the built-in UI (fast-forward pull only).
MEMEDESK_UI_DIR=
TUNNEL_TOKEN=
